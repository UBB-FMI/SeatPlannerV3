[Unit]
Description=Seatplan HTTP backend
After=network.target
[Service]
User=seatplan
Group=seatplan
WorkingDirectory=/opt/seatplan
EnvironmentFile=/opt/seatplan/.env
Environment=DATA_DIR=/var/lib/seatplan
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/seatplan/.venv/bin/uvicorn seatplan.app:create_app --factory --host 127.0.0.1 --port 8000 --workers 2 --no-proxy-headers --limit-concurrency 80
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seatplan
[Install]
WantedBy=multi-user.target
