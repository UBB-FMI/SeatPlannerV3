# HTTPS public address, optionally with a subpath. No trailing slash.
PUBLIC_URL=https://seats.example.org
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
APP_SECRET=CHANGE_ME
ADMIN_EMAILS=admin@example.org
DEVELOPMENT=0
MAIL_BACKEND=smtp
MAIL_FROM="Seat reservations <seats@example.org>"
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=seats@example.org
SMTP_PASSWORD=CHANGE_ME
# starttls: usually 587; ssl: usually 465; plain: trusted unauthenticated relay only.
# Set exact proxy IP/CIDR entries only when the proxy overwrites X-Real-IP.
TRUSTED_PROXY_CIDRS=
SESSION_HOURS=24
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=10
